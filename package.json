{
  "name": "fuck-shuwei",
  "version": "1.0.0",
  "author": "Zyyo",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "crypto-js": "^4.2.0",
    "express": "^5.1.0",
    "naive-ui": "^2.42.0",
    "open": "^10.1.2",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  },
  "scripts": {
    "start": "node ./src/server.js",
    "dev:fe": "vite",
    "build:fe": "vite build",
    "preview:fe": "vite preview --port 4173",
    "build": "esbuild ./src/server.js --bundle --minify --outfile=./dist/dist.js --platform=node",
    "build:win": "npm run build && npx --yes pkg . --targets node18-win-x64 --output ./dist/$(node -p \"require('./package.json').name\").exe",
    "build:mac": "npm run build && pkg . --targets node18-macos-x64",
    "build:linux": "npm run build && pkg . --targets node18-linux-x64"
  },
  "bin": "./dist/dist.js",
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  }
}
